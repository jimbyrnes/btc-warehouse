# Copy this file to .env and fill in real values. .env is git-ignored --
# never commit real credentials.
#
# Used by:
#   - btc_ingest/snowflake_loader.py (via python-dotenv, automatically)
#   - dbt/profiles.yml.example (via env_var() -- export these into your
#     shell first: `set -a && source .env && set +a`)

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=BTC_WAREHOUSE_WH
SNOWFLAKE_DATABASE=BTC_WAREHOUSE
SNOWFLAKE_SCHEMA=RAW
